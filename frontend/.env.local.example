# Copy to .env.local for local development. In production (Vercel), set every one of these
# directly in Project Settings -> Environment Variables instead - never commit real values here,
# and never commit .env.local itself (already gitignored).

# --- Supabase project ---
# NEXT_PUBLIC_* vars are exposed to the browser bundle - safe only because Supabase's anon key is
# designed to be public and every table is protected by RLS, never by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key - bypasses RLS entirely. Server-only, read exclusively from API routes via
# lib/supabase/admin.ts. Must NEVER be prefixed with NEXT_PUBLIC_ or referenced from a "use client"
# file - Vercel will happily inline a NEXT_PUBLIC_ var into the client bundle, so getting this
# prefix wrong would leak full database access to every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Textbook Factory (Step 15) - primary/fallback LLM providers ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Stripe B2C checkout + webhooks (Step 31) ---
# Use test-mode keys (sk_test_.../whsec_...) for local dev and Preview deployments. Production
# needs its own LIVE secret key and its own webhook secret - a live webhook endpoint
# (https://<production-domain>/api/webhooks/stripe) has to be registered separately in the Stripe
# Dashboard, which generates a distinct whsec_... value from the one used locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional - flat price in cents for digital textbook access. Defaults to 4999 ($49.99) if unset.
STRIPE_COURSE_PRICE_CENTS=

# --- Integration test suite (Step 33) ---
# Optional - only read by `npm run test:integration`, never by the app itself. Defaults to
# http://localhost:3000; only needed if testing against a deployed Preview/Production URL instead.
INTEGRATION_TEST_BASE_URL=

# --- Transactional email notifications (Step 41) ---
# Optional - sendTransactionalEmail() (frontend/src/lib/notifications/email-service.ts) calls
# Resend's REST API directly (no SDK dependency) when this is set. With no key set, it falls back
# to a console-logged simulation instead of failing - safe for local dev with zero setup.
RESEND_API_KEY=
# Optional - defaults to "BalootBooks <notifications@balootbooks.com>" if unset.
TRANSACTIONAL_EMAIL_FROM=
